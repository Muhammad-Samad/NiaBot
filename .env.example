# ============================================================
# npk_combine_chatbot - environment configuration
# Copy this file to .env and fill in real values.
# ============================================================

# ─── Flask ──────────────────────────────────────────────────
FLASK_SECRET_KEY=nia_chatbot_flask_key
FLASK_DEBUG=true
FLASK_PORT=5001

# ─── Database (single shared DB — must contain BOTH the shopping schema
# [cart_sessions, cart_items, orders, order_items, conversation_messages] AND
# the Magento order-tracking schema the operations flows query) ────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Connection pool
DB_POOL_NAME=
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=10
DB_POOL_RESET_SESSION=False
# Set to "true" to fall back to a mock order instead of raising when the DB
# is unreachable during order-tracking lookups (operations domain). Leave
# false for real use.
DB_MOCK_FALLBACK=false

# ─── Shopping domain: Typesense ────────────────────────────────────────────
TYPESENSE_HOST=
TYPESENSE_PORT=
TYPESENSE_PROTOCOL=
TYPESENSE_API_KEY=
TYPESENSE_PRODUCTS_COLLECTION=
TYPESENSE_CATEGORIES_COLLECTION=npk_livedefault-categories
TYPESENSE_CONV_MODEL_ID=

# Numeric field used for price filter_by; must exist on the products collection.
PRICE_FIELD=price
# Vector distance cutoff (0-1) for filtering weak semantic matches. 1.0 disables filtering.
VECTOR_DISTANCE_THRESHOLD=0.1

# ─── Shopping domain: LLM (query understanding / off-topic guard + embeddings) ──
# Must be a real OpenAI key — used for both chat completions (query
# understanding) and text-embedding-3-small (product search embeddings).
SHOPPING_LLM_API_KEY=
SHOPPING_LLM_MODEL=

# ─── Operations domain: LLM providers (tried in this order, with failover) ─
# LLM_PROVIDER_CHAIN=openai,groq,gemini
LLM_PROVIDER_CHAIN=openai
LLM_FAILURE_THRESHOLD=3

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# Minimum confidence (0-1) an LLM intent classification needs before it's
# trusted; below this the operations domain falls back to its rule-based router.
AI_CONFIDENCE_THRESHOLD=0.85
# Reject a single message longer than this many words.
MAX_INPUT_WORDS=100

# ─── Operations domain: rate limiting (token bucket, per session) ─────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_RATE=0.1
RATE_LIMIT_MESSAGE=You are sending messages too quickly. Please wait a moment before sending another message.

# ─── Policy domain: RAG (ChromaDB + OpenAI) ───────────────────────────────
# Always answers with gpt-4o-mini (fixed in config/policy.py, not configurable).
# Leave empty to reuse OPENAI_API_KEY above.
POLICY_OPENAI_API_KEY=
# Must match the model the Chroma index was built with - re-run
# `python -m scripts.ingest_policy --reset` after changing either of these.
POLICY_EMBEDDING_PROVIDER=openai
POLICY_EMBEDDING_MODEL=text-embedding-3-small
# Paths are relative to the project root.
POLICY_DOCUMENTS_DIR=domains/policy/knowledge
POLICY_CHROMA_DIR=domains/policy/chroma
POLICY_CHROMA_COLLECTION=naheed_policy
POLICY_LLM_TEMPERATURE=0.1
POLICY_LLM_MAX_TOKENS=500
POLICY_RETRIEVAL_TOP_K=5
# Cosine distance cut-off (0 = identical). Lower = stricter.
POLICY_RETRIEVAL_MAX_DISTANCE=0.75
POLICY_HISTORY_TURNS=4
POLICY_MAX_INPUT_CHARS=1000
POLICY_SESSION_TTL_MINUTES=60
POLICY_SUPPORT_PHONE=(021) 111-624-333
POLICY_SUPPORT_EMAIL=support@naheed.pk
# Chunking (only used by scripts/ingest_policy.py)
POLICY_CHUNK_MAX_CHARS=1200
POLICY_CHUNK_MIN_CHARS=150
POLICY_CHUNK_OVERLAP_CHARS=200

# ─── Logging ────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR. Console + logs/application.log.
LOG_LEVEL=INFO
